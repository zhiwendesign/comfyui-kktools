    "output_types": [
      {
        "name": "视频输出",
        "type": "STRING"
      }
    ]
  },
  "OpenMAIC_导出设置": {
    "category": "OpenMAIC/导出",
    "display_name": "导出设置",
    "description": "创建视频导出配置",
    "input_types": {
      "required": {
        "分辨率": {
          "type": "STRING",
          "default": "1080p"
        },
        "帧率": {
          "type": "INT",
          "default": 30
        },
        "编码器": {
          "type": "STRING",
          "default": "nvenc"
        }
      }
    },
    "output_types": [
      {
        "name": "设置",
        "type": "DICT"
      }
    ]
