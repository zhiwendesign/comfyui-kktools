  "OpenMAIC_FunASR字幕对齐": {
    "category": "OpenMAIC/音频",
    "display_name": "FunASR字幕对齐",
    "description": "使用 FunASR 语音识别对齐字幕时间点",
    "input_types": {
      "required": {
        "音频路径": {
          "type": "STRING"
        },
