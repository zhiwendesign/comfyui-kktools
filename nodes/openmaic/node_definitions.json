      }
    ]
  },
  "OpenMAIC_音频混音": {
    "category": "OpenMAIC/音频",
    "display_name": "音频混音",
    "description": "混音：讲解音频 + 背景音乐",
    "input_types": {
      "required": {
        "讲解音频": {
          "type": "STRING"
        }
      },
      "optional": {
        "背景音乐": {
          "type": "STRING",
          "default": ""
        },
        "讲解音量": {
          "type": "INT",
          "default": 0
        },
        "BGM音量": {
          "type": "INT",
          "default": -18
        }
      }
    },
    "output_types": [
      {
        "name": "混音音频",
        "type": "STRING"
      }
    ]
  },
  "OpenMAIC_字幕生成": {
    "category": "OpenMAIC/音频",
