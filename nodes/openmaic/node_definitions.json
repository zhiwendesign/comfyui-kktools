          "type": "LIST"
        }
      }
    },
    "output_types": [
      {
        "name": "字幕文件",
        "type": "STRING"
      }
    ]
  },
  "OpenMAIC_视频导出": {
    "category": "OpenMAIC/导出",
    "display_name": "视频导出",
    "description": "视频导出：合并画面、音频、字幕、BGM",
    "input_types": {
      "required": {
        "视频画面": {
          "type": "STRING"
        },
        "讲解音频": {
          "type": "STRING"
        },
